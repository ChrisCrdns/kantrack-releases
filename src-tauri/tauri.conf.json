{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KanTrack",
  "version": "1.0.52",
  "identifier": "com.yourname.kantrack",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KanTrack",
        "width": 560,
        "height": 430,
        "minWidth": 560,
        "minHeight": 200,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFMUU0OUUxREFCRTEyNzEKUldSeEVyN2E0VWtlZnFIMW9zRkVYN0NDRlJuZDRCVkFDSVZGak12eWZrYTQxMWpGNW1ZRkdrZ0cK",
      "endpoints": [
        "https://github.com/ChrisCrdns/kantrack-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
